# STTM standalone — copy to .env and fill in values

# LLM (required for agent features). Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Or: GROQ_API_KEY= + LLM_PROVIDER=groq

# Auth — header-based dev identity (no SSO)
APP_SESSION_AUTH_MODE=dev
APP_SESSION_DEV_USER_ID=local-user
APP_SESSION_DEV_USER_EMAIL=user@local

# CORS — add your deployed frontend origin(s), comma-separated
DATAMAP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) — leave empty in local dev to use /sttm-api proxy
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
