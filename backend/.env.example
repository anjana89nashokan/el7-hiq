# Standalone STTM (no Launchpad SSO)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Header-based dev identity — frontend sends x-dev-user-id / x-dev-user-email
APP_SESSION_AUTH_MODE=dev
APP_SESSION_DEV_USER_ID=local-user
APP_SESSION_DEV_USER_EMAIL=user@local

# Optional CORS override (comma-separated). Defaults include localhost:5173.
# DATAMAP_CORS_ORIGINS=https://your-frontend-host
